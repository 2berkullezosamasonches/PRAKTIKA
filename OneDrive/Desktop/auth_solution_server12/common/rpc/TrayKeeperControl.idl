[
    uuid(9f0c7a24-135e-4d33-9e90-872f2e5f8151),
    version(1.0),
    implicit_handle(handle_t TrayKeeperControlBinding)
]
interface TrayKeeperControl
{
    typedef struct _TK_AUTH_INFO
    {
        long authenticated;
        [string] wchar_t* username;
    } TK_AUTH_INFO;

    typedef struct _TK_LICENSE_INFO
    {
        long active;
        [string] wchar_t* expiresAt;
        [string] wchar_t* message;
    } TK_LICENSE_INFO;

    typedef struct _TK_AV_DATABASE_INFO
    {
        long loaded;
        long recordCount;
        [string] wchar_t* releaseDate;
        [string] wchar_t* message;
    } TK_AV_DATABASE_INFO;

    typedef struct _TK_SCAN_RESULT
    {
        long scannedObjects;
        long infectedObjects;
        long clean;
        [string] wchar_t* details;
    } TK_SCAN_RESULT;

    long TrayKeeperGetCurrentUser([out] TK_AUTH_INFO* info);
    long TrayKeeperLogin([in, string] wchar_t* username, [in, string] wchar_t* password, [out] TK_AUTH_INFO* info);
    void TrayKeeperLogout();

    long TrayKeeperGetLicenseInfo([out] TK_LICENSE_INFO* info);
    long TrayKeeperActivateProduct([in, string] wchar_t* activationCode, [out] TK_LICENSE_INFO* info);
    long TrayKeeperGetAntivirusState();
    long TrayKeeperGetAvDatabaseInfo([out] TK_AV_DATABASE_INFO* info);
    long TrayKeeperScanFile([in, string] wchar_t* path, [out] TK_SCAN_RESULT* result);
    long TrayKeeperScanDirectory([in, string] wchar_t* path, [out] TK_SCAN_RESULT* result);
    long TrayKeeperScanFixedDrives([out] TK_SCAN_RESULT* result);
    long TrayKeeperStartDirectoryMonitor([in, string] wchar_t* path, [out] TK_SCAN_RESULT* result);
    long TrayKeeperStopDirectoryMonitor([out] TK_SCAN_RESULT* result);
    long TrayKeeperGetDirectoryMonitorStatus([out] TK_SCAN_RESULT* result);
    long TrayKeeperStartScheduledDirectoryScan([in, string] wchar_t* path, [in] long intervalSeconds, [out] TK_SCAN_RESULT* result);
    long TrayKeeperStopScheduledScan([out] TK_SCAN_RESULT* result);
    long TrayKeeperGetScheduledScanStatus([out] TK_SCAN_RESULT* result);

    void TrayKeeperStopService();
}
